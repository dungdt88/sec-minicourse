# Copy to .env.local for development. Production: GitHub Actions variables, passed as Docker build args (README "Deploy").
# VITE_BACKEND: "supabase" (default) or "local" (in-browser demo data, no server).
VITE_BACKEND=supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_TEAM_SLUG=default
